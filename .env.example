# Falcon Premium Bot configuration
# NEVER share your real .env file or bot token.
DISCORD_TOKEN=

# Primary bot owner IDs (comma-separated if you ever need more than one)
OWNER_IDS=
PRIMARY_OWNER_ID=

# Discord application and database
BOT_APPLICATION_ID=
DATABASE_PATH=data/falcon_data.db
DATABASE_URL=postgresql://falcon:change-me@localhost:5432/falcon
POSTGRES_USER=falcon
POSTGRES_PASSWORD=change-me
POSTGRES_PASSWORD_URLENC=change-me
POSTGRES_DB=falcon

# Bot identity
BOT_NAME=Falcon
PREFIX=,
STATUS_TEXT=,help
# Use a channel URL so Discord can link the Streaming activity correctly.
STREAM_STATUS_URL=https://www.twitch.tv/your_channel
BOT_COLOR=ffdd00

# Optional links (leave blank if you do not have them yet)
INVITE_URL=
INVITE_URL_LIMITED=
INVITE_URL_ADMIN=
SUPPORT_SERVER_URL=
SUPPORT_SERVER=

# Optional temporary voice-room join/leave notices (default: false)
ROOM_JOIN_LEAVE_MESSAGES=false

# Premium configuration
PREMIUM_MANAGER_IDS=

# Optional GIPHY API key for social action GIFs
GIPHY_API_KEY=

# Automatic emoji upload
AUTO_UPLOAD_EMOJIS=false
EMOJI_FOLDER=emojis
GUILD_ID=
